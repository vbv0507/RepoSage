# Gemini is primary. Grok is an automatic fallback when XAI_API_KEY is set.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7
OPENAI_API_KEY=

# Disabled by default so a re-index does not make one LLM request for every
# Git commit. Enable only when generated Git intent summaries are needed.
GIT_ARCHAEOLOGY_LLM_SUMMARIES=false

# CORS origins (comma-separated). Set this to the exact Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# Optional allowed git hosts for remote repository cloning (comma-separated)
# ALLOWED_GIT_HOSTS=github.com,gitlab.com

# Render Free paths. These are ephemeral on the free tier.
CHROMA_PATH=/tmp/chroma
CLONED_REPO_ROOT=/tmp/reposage_clones
UPLOAD_REPO_ROOT=/tmp/reposage_uploads

# Keep the hosted demo useful after an empty-space restart.
AUTO_INDEX_SAMPLE_REPO=true
# SAMPLE_REPOSITORY_URL=https://github.com/vbv0507/RepoSage
# SAMPLE_REPOSITORY_MAX_FILES=25

# Agent API token used by trusted server-to-server integrations such as Spidy.
# AGENT_SECRET=

