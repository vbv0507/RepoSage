# Choose one LLM provider: gemini or openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional local-folder analysis when using Docker on Windows.
# This folder is mounted read-only in the backend at /workspace. Any path you
# enter in RepoSage must be inside this folder.
# HOST_REPO_ROOT=C:/Users/your-name/OneDrive/Desktop
