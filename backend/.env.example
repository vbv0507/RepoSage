# Server port. Render supplies PORT automatically; 7860 is the local fallback.
PORT=7860

# LLM Provider: Gemini is primary. Set grok or openai only to force one provider.
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
# GOOGLE_API_KEY= # Optional Gemini-key alias
GEMINI_MODEL=gemini-2.5-flash
# Embedding backend: auto, gemini, local, or hash. Use hash to keep Gemini for
# answers while avoiding Gemini embedding quota during local indexing.
EMBEDDING_BACKEND=auto

# xAI Grok fallback used automatically when Gemini fails or is unavailable.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173

# Optional allowed git hosts for remote repository cloning (comma-separated)
# ALLOWED_GIT_HOSTS=github.com,gitlab.com

# Disabled by default so re-indexing does not make an LLM request per Git commit.
GIT_ARCHAEOLOGY_LLM_SUMMARIES=false

# Render's local disk paths. They are ephemeral on the free tier.
CHROMA_PATH=/tmp/chroma
# Optional semantic answer cache plus local MiniLM model. Keep off on Render Free.
SEMANTIC_CACHE=off
MAX_CHUNKS_PER_REPO=500
MAX_PROMPT_CONTEXT_CHARS=30000
GEMINI_EMBED_REQUESTS_PER_SECOND=1
# CLONED_REPO_ROOT=/tmp/reposage_clones
# UPLOAD_REPO_ROOT=/tmp/reposage_uploads

# Optional sample repository startup warm-up. Keep false on Render Free.
AUTO_INDEX_SAMPLE_REPO=false
# SAMPLE_REPOSITORY_URL=https://github.com/vbv0507/RepoSage
# SAMPLE_REPOSITORY_MAX_FILES=25

# Authenticates trusted server-to-server calls to /api/agent.
# AGENT_SECRET=

# Optional local Docker-only mapping for a mounted Windows folder.
# HOST_REPO_ROOT=C:/Users/your-name/Projects
# REPO_MOUNT_PATH=/workspace
