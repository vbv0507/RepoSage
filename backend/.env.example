# RepoSage Backend Configuration
PORT=5000

# Redis Cache (Local or Docker)
REDIS_URL=redis://localhost:6379

# ChromaDB Vector Store (Local or Docker)
CHROMA_URL=http://localhost:8000

# LLM Provider: "gemini" (recommended) or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# CORS configuration (comma-separated list of allowed origins)
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional allowed git hosts for remote repository cloning (comma-separated)
# ALLOWED_GIT_HOSTS=github.com,gitlab.com


